{
  "public_board": {
    "my_class": {
      ".write": "auth != null && auth.uid === 'gITUMG3dVeSpPpqfXemlBYelLge2'",
      ".validate": "newData.hasChildren(['shared', 'students'])",
      "shared": {
        ".read": true,
        ".validate": "newData.hasChildren(['studentCount'])",
        "tasks": { ".validate": true },
        "taskDates": { ".validate": true },
        "announcements": { ".validate": "newData.isString()" },
        "studentCount": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      },
      "students": {
        "$key": {
          ".read": true,
          ".validate": "$key.matches(/^[0-9a-f]{64}$/) && newData.hasChildren(['v'])",
          "v": { ".validate": "newData.isNumber()" },
          "tasks": {
            "$task": { ".validate": "newData.isNumber()" }
          },
          "att": {
            "$date": { ".validate": "$date.matches(/^20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" }
          },
          "$other": { ".validate": false }
        }
      },
      "$other": { ".validate": false }
    }
  }
}
